# =========================================================
# DEFENSE-IN-DEPTH: block direct access to sensitive files
# (in case the "route everything through public/" rewrite
# below ever fails to fire on this host)
# =========================================================

Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|htaccess_disable|lock|log|sqlite)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>

    RewriteEngine On
 
    # Redirect to HTTPS

    RewriteCond %{HTTPS} off

    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
 
    # Remove public from URL

    RewriteCond %{REQUEST_URI} !^/public/

    RewriteRule ^(.*)$ public/$1 [L,QSA]
 
    # Handle index.php and remove public from the URL

    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /public/([^\ ]+)

    RewriteRule ^public/(.*) /$1 [R=301,L]
 
    # Redirect Trailing Slashes...

    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^(.*)/$ /$1 [L,R=301]
 
    # Handle Front Controller...

    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteCond %{REQUEST_FILENAME} !-f

    RewriteRule ^ index.php [L]
</IfModule>
  
<IfModule mod_headers.c>

    # =========================================================
    # SECURITY HEADERS
    # =========================================================

    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    Header always set X-Content-Type-Options "nosniff"

    Header always set X-Frame-Options "DENY"

    Header always set X-XSS-Protection "1; mode=block"

    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"


    # =========================================================
    # PUBLIC WEBSITE CSP
    # =========================================================

    Header always set Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://assets.apollo.io https://embed.tawk.to https://*.tawk.to https://cdn.botpress.cloud https://files.bpcontent.cloud; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://embed.tawk.to https://cdnjs.cloudflare.com https://cdn.botpress.cloud https://*.botpress.cloud; font-src 'self' data: https://fonts.gstatic.com https://embed.tawk.to https://*.tawk.to https://cdnjs.cloudflare.com https://cdn.botpress.cloud https://*.botpress.cloud; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://assets.apollo.io https://aplo-evnt.com https://*.tawk.to wss://*.tawk.to https://cdn.botpress.cloud https://files.bpcontent.cloud https://*.botpress.cloud wss://*.botpress.cloud; frame-src https://*.tawk.to https://www.google.com https://www.google.co.in https://maps.google.com https://www.google.com/maps https://www.google.com/maps/embed https://www.googleusercontent.com https://cdn.botpress.cloud https://*.botpress.cloud; frame-ancestors 'none'; upgrade-insecure-requests" env=!IS_BACKEND


    # =========================================================
    # ADMIN / BACKEND CSP
    # =========================================================

    Header always set Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://assets.apollo.io https://embed.tawk.to https://*.tawk.to https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com https://kit.fontawesome.com https://unpkg.com https://code.jquery.com https://static.addtoany.com https://cdn.ckeditor.com https://cdn.datatables.net https://cdn.botpress.cloud https://files.bpcontent.cloud; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://embed.tawk.to https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com https://kit.fontawesome.com https://cdn.datatables.net https://cdn.botpress.cloud https://*.botpress.cloud; font-src 'self' data: https://fonts.gstatic.com https://embed.tawk.to https://*.tawk.to https://stackpath.bootstrapcdn.com https://kit.fontawesome.com https://cdn.botpress.cloud https://*.botpress.cloud; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://assets.apollo.io https://aplo-evnt.com https://*.tawk.to wss://*.tawk.to https://cdn.jsdelivr.net https://stackpath.bootstrapcdn.com https://ka-f.fontawesome.com https://cdn.botpress.cloud https://files.bpcontent.cloud https://*.botpress.cloud wss://*.botpress.cloud; frame-src https://*.tawk.to https://static.addtoany.com https://cdn.botpress.cloud https://*.botpress.cloud; frame-ancestors 'none'; upgrade-insecure-requests" env=IS_BACKEND

</IfModule>